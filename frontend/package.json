{
  "name": "furfiles-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
