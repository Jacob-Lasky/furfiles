{
  "name": "furfiles-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.0"
  }
}
